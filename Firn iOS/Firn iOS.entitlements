<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync (off until the person turns it on): Firn's own CloudKit container, in the person's private iCloud
	     database. Everything Firn puts there is sealed on the phone first (docs/SYNC-PLAN.md). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.firnbrowser.firn</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Production, as the Mac's Developer ID build must be: builds from Xcode would otherwise use Development, a
	     separate database, and never see the Mac's records (docs/SYNC-PLAN.md, step 3). -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<!-- Silent pushes from iCloud, so a change made on another device arrives without waiting. Development for builds
	     from Xcode; Xcode switches it to production when exporting for the App Store. Nothing registers for them
	     until sync is turned on. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets people pick Firn as the iPhone's default browser (Settings › Apps › Default Browser App). A managed
	     entitlement Apple granted on 2026-11-14; the app ID has to have it turned on (Additional Capabilities) or
	     builds for a device won't sign. Apple's rules for browsers are met: http and https in Info.plist, no
	     UIWebView, an address bar on launch, links opened as they are, and none of the Info.plist keys Apple
	     rejects browsers for (photo library read access, Always location, HomeKit, Bluetooth Always, Health). -->
	<key>com.apple.developer.web-browser</key>
	<true/>
</dict>
</plist>
