<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Web address</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Sites you allow can use the camera, for video calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sites you allow can use the microphone, for calls and voice.</string>
	<!-- Holding a picture on a page offers WebKit's own "Save to Photos", and iOS ends an app that tries it without
	     this. Add-only: Firn can put a picture in Photos, never look at what's there (the full-access key,
	     NSPhotoLibraryUsageDescription, is one Apple rejects browsers for). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Firn saves the pictures you choose to Photos. It can't see the rest of your library.</string>
	<!-- Web pages may load over plain http (App Transport Security would refuse them all). Only web content:
	     Firn's own requests (site icons, updates) still need https. Firn says so (the address bar's "Not Secure" is planned),
	     and an https guess falls back to http only when the person presses Continue. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
