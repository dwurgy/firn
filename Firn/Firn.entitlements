<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: Firn can only touch what it's given. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing network connections: needed to load web pages. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Only files a person picks in an Open or Save panel (uploading to a site, saving a PDF), nothing else on disk. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The Downloads folder, so a download saves there without a Save panel. Nothing else on disk. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- The camera and microphone, used only after a site asks and you click Allow (macOS asks once too). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Printing a page from File › Print. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Firn's own place in the Keychain, for saved passwords: only Firn can read it (granted by the "Firn Developer ID"
	     provisioning profile; without the profile, macOS won't open the app). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.firnbrowser.firn</string>
	</array>
	<!-- WebKit's Deceptive Website Warning: lets WebKit ask the Mac's own Safe Browsing service (the one Safari uses)
	     about a page. Only this one service. Without it the sandbox blocks the check and scam pages load with no warning. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.Safari.SafeBrowsing.Service</string>
	</array>
</dict>
</plist>
