<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: Firn can only touch what it's given. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing network connections: needed to load web pages. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Only files a person picks in an Open or Save panel (uploading to a site, saving a PDF), nothing else on disk. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The Downloads folder, so a download saves there without a Save panel. Nothing else on disk. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- The camera and microphone, used only after a site asks and you click Allow (macOS asks once too). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Printing a page from File › Print. -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
